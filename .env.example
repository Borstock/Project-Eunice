# ============================================================
# Habit Tracker – Environment Variables Example
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
#
# All variables are prefixed with VITE_ so Vite exposes them
# to the browser bundle. Because they are public, do NOT put
# API keys, passwords, or any secret data here.
# ============================================================

# Display name shown in the navbar and browser tab.
VITE_APP_NAME=Habit Tracker

# Namespace prefix for every localStorage key the app writes.
# Change this if you need to run two instances side-by-side.
# WARNING: changing an existing value will make the app appear
# empty on first load (old keys are automatically migrated on
# the first run, so data is not lost).
VITE_STORAGE_PREFIX=habit_tracker_

# Set to "true" to enable verbose debug logging in the console.
# Any other value (or omitting the variable) disables logging.
VITE_ENABLE_DEBUG=false
